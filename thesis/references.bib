@misc{bruceWidebandRFIMonitor2026,
  title = {Wideband {{RFI Monitor Requirements}}, {{Design}}, and {{Commissioning}} at {{DRAO}}},
  author = {Bruce, Nicholas and Baard, Charl and Harrison, Stephen and Islam, Mohammad and Otto, Abraham J. and Lagoy, Dustin and Messing, Robert and Robert, Benoit and Robishaw, Timothy and Driessen, Peter F.},
  year = 2026,
  month = may,
  number = {arXiv:2605.08479},
  eprint = {2605.08479},
  primaryclass = {astro-ph.IM},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2605.08479},
  urldate = {2026-06-08},
  abstract = {In this paper, we introduce the radio frequency interference monitor deployed at the Dominion Radio Astrophysical Observatory. It provides 2 GHz of instantaneous bandwidth, supporting channel bandwidths as fine as \textasciitilde 100 Hz for 1 s integrations, or integration times as low as \textasciitilde 50 ms for the standard 3.33 kHz channel bandwidth. After operating as a prototype instrument for several years, the monitor was commissioned to improve the calibration method, analog section temperature, and gain stability. It now operates both as a transient detector and as a long-term radio environment characterization tool. We introduce novel applications for the monitor and derive a new method for calculating the effect of gain drift on integrated data.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Instrumentation and Methods for Astrophysics},
  file = {/Users/duncancs/Zotero/storage/2W2Z47G3/Bruce et al. - 2026 - Wideband RFI Monitor Requirements, Design, and Commissioning at DRAO.pdf;/Users/duncancs/Zotero/storage/NQUUXERQ/2605.html}
}


@article{emigFirstDetectionRadio2019,
  title = {The First Detection of Radio Recombination Lines at Cosmological Distances},
  author = {Emig, K. L. and Salas, P. and de Gasperin, F. and Oonk, J. B. R. and Toribio, M. C. and R{\"o}ttgering, H. J. A. and Tielens, A. G. G. M.},
  year = 2019,
  month = feb,
  journal = {Astronomy \& Astrophysics},
  volume = {622},
  pages = {A7},
  publisher = {EDP Sciences},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/201834052},
  urldate = {2025-06-03},
  abstract = {\emph{Context.{$<$}i/{$>$} Recombination lines involving high principal quantum numbers (n {$\sim$} 50 - 1000) populate the radio spectrum in large numbers. Low-frequency ({$<$} 1 GHz) observations of radio recombination lines (RRLs) primarily from carbon and hydrogen offer a new, if not unique, way to probe cold, largely atomic gas and warm, ionised gas in other galaxies. Furthermore, RRLs can be used to determine the physical state of the emitting regions, such as temperature and density. These properties make RRLs, potentially, a powerful tool of extragalactic interstellar medium (ISM) physics. At low radio frequencies, it is conceivable to detect RRLs out to cosmological distances when illuminated by a strong radio continuum. However, they are extremely faint (\emph{{$\tau<$}i/{$>$}\textsubscript{peak{$<$}sub/{$>$} {$\sim$} 10\textsuperscript{-3{$<$}sup/{$>$} - 10\textsuperscript{-4{$<$}sup/{$>$}) and have so far eluded detection outside of the local universe.\emph{Aims.{$<$}i/{$>$} With observations of the radio quasar 3C 190 (\emph{z{$<$}i/{$>$} = 1.1946), we aim to demonstrate that the ISM can be explored out to great distances through low-frequency RRLs.\emph{Methods{$<$}i/{$>$}. 3C 190 was observed with the LOw Frequency ARray (LOFAR) and processed using newly developed techniques for spectral analysis.\emph{Results.{$<$}i/{$>$} We report the detection of RRLs in the frequency range 112 MHz--163 MHz in the spectrum of 3C 190. Stacking 13 \emph{{$\alpha<$}i/{$>$}-transitions with principal quantum numbers n = 266 - 301, a peak 6\emph{{$\sigma<$}i/{$>$} feature of optical depth \emph{{$\tau<$}i/{$>$}\textsubscript{peak{$<$}sub/{$>$} = (1.0 \textpm{} 0.2)\texttimes 10\textsuperscript{-3{$<$}sup/{$>$} and FWHM = 31.2 \textpm{} 8.3 km s\textsuperscript{-1{$<$}sup/{$>$} was found at \emph{z{$<$}i/{$>$} = 1.124. This corresponds to a velocity offset of -9965 km s\textsuperscript{-1{$<$}sup/{$>$} with respect to the systemic redshift of 3C 190.\emph{Conclusions.{$<$}i/{$>$} We consider three interpretations of the origin of the RRL emission: an intervening dwarf-like galaxy, an active galactic nucleus (AGN) driven outflow, and the inter-galactic medium. We argue that the recombination lines most likely originate in a dwarf-like galaxy (\emph{M{$<$}i/{$>$} {$\sim$} 10\textsuperscript{9{$<$}sup/{$>$} \emph{M{$<$}i/{$>$}\textsubscript{{$\odot<$}sub/{$>$}) along the line of sight, although we cannot rule out an AGN-driven outflow. We do find the RRLs to be inconsistent with an inter-galactic medium origin. With this detection, we have opened up a new way to study the physical properties of cool, diffuse gas out to cosmological distances.}}}}}}}}}}}}}}}}}}}}}}},
  copyright = {\copyright{} ESO 2019},
  langid = {english},
  keywords = {Stacking},
  file = {/Users/duncancs/Zotero/storage/C3422SLC/Emig et al. - 2019 - The first detection of radio recombination lines at cosmological distances.pdf}
}


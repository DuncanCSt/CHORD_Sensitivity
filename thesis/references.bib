@article{andersonGBTDiffuseIonized2021,
  title = {The {{GBT Diffuse Ionized Gas Survey}} ({{GDIGS}}): {{Survey Overview}} and {{First Data Release}}},
  shorttitle = {The {{GBT Diffuse Ionized Gas Survey}} ({{GDIGS}})},
  author = {Anderson, L. D. and Luisi, Matteo and Liu, Bin and Wenger, Trey V. and Balser, {\relax Dana}. S. and Bania, T. M. and Haffner, L. M. and Linville, Dylan J. and Mascoop, J. L.},
  year = 2021,
  month = may,
  journal = {The Astrophysical Journal Supplement Series},
  volume = {254},
  number = {2},
  pages = {28},
  publisher = {The American Astronomical Society},
  issn = {0067-0049},
  doi = {10.3847/1538-4365/abef65},
  urldate = {2025-06-03},
  abstract = {The Green Bank Telescope (GBT) Diffuse Ionized Gas Survey (GDIGS) traces ionized gas in the Galactic midplane by measuring 4--8 GHz radio recombination line (RRL) emission. The nominal survey zone is 32.{$^\circ$}3 {$>$} {$\ell$} {$>$} - 5{$^\circ$}, {$\mid$}b{$\mid$} {$<$} 0.{$^\circ$}5, but coverage extends above and below the plane in select fields and additionally includes the areas around W47 ({$\ell$} {$\simeq$} 37.{$^\circ$}5) and W49 ({$\ell$} {$\simeq$} 43{$^\circ$}). GDIGS simultaneously observes 22 Hn{$\alpha$} (15 usable), 25 Hn{$\beta$} (18 usable), and 8 Hn{$\gamma$} RRLs (all usable), as well as multiple molecular line transitions (including those of , H2CO, and CH3OH). Here, we describe the GDIGS survey parameters and characterize the RRL data, focusing primarily on the Hn{$\alpha$} data. We produce sensitive data cubes by averaging the usable RRLs, after first smoothing to a common spectral resolution of 0.5 km s-1 and a spatial resolution of 2.{$\prime$}65 for Hn{$\alpha$}, 2.{$\prime$}62 for Hn{$\beta$}, and 2.{$\prime$}09 for Hn{$\gamma$}. The average spectral noise per spaxel in the Hn{$\alpha$} data cubes is {$\sim$}10 mK ({$\sim$}5 mJy beam-1). This sensitivity allows GDIGS to detect RRLs from plasma throughout the inner Galaxy. The GDIGS Hn{$\alpha$} data are sensitive to emission measures EM {$\greaterequivlnt$} 1100 cm-6 pc, which corresponds to a mean electron density \textlangle n e \textrangle{} {$\greaterequivlnt$} 30 cm-3 for a 1 pc path length or \textlangle n e \textrangle{} {$\greaterequivlnt$} 1 cm-3 for a 1 kpc path length.},
  langid = {english},
  keywords = {Observational Surveys},
  file = {/Users/duncancs/Zotero/storage/XRH9AWS8/Anderson et al. - 2021 - The GBT Diffuse Ionized Gas Survey (GDIGS) Survey Overview and First Data Release.pdf}
}

